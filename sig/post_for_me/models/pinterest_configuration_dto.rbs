module PostForMe
  module Models
    type pinterest_configuration_dto =
      {
        board_ids: ::Array[String]?,
        caption: top?,
        link: String?,
        media: ::Array[PostForMe::SocialPostMedia]?,
        title: String?
      }

    class PinterestConfigurationDto < PostForMe::Internal::Type::BaseModel
      attr_accessor board_ids: ::Array[String]?

      attr_accessor caption: top?

      attr_accessor link: String?

      attr_accessor media: ::Array[PostForMe::SocialPostMedia]?

      attr_accessor title: String?

      def initialize: (
        ?board_ids: ::Array[String]?,
        ?caption: top?,
        ?link: String?,
        ?media: ::Array[PostForMe::SocialPostMedia]?,
        ?title: String?
      ) -> void

      def to_hash: -> {
        board_ids: ::Array[String]?,
        caption: top?,
        link: String?,
        media: ::Array[PostForMe::SocialPostMedia]?,
        title: String?
      }
    end
  end
end
