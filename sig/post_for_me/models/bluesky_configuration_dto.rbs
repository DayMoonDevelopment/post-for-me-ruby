module PostForMe
  module Models
    type bluesky_configuration_dto =
      { caption: top?, media: ::Array[PostForMe::SocialPostMedia]? }

    class BlueskyConfigurationDto < PostForMe::Internal::Type::BaseModel
      attr_accessor caption: top?

      attr_accessor media: ::Array[PostForMe::SocialPostMedia]?

      def initialize: (
        ?caption: top?,
        ?media: ::Array[PostForMe::SocialPostMedia]?
      ) -> void

      def to_hash: -> {
        caption: top?,
        media: ::Array[PostForMe::SocialPostMedia]?
      }
    end
  end
end
