module PostForMe
  module Models
    type social_post_media =
      {
        url: String,
        skip_processing: bool?,
        tags: ::Array[PostForMe::SocialPostMedia::Tag]?,
        thumbnail_timestamp_ms: top?,
        thumbnail_url: top?
      }

    class SocialPostMedia < PostForMe::Internal::Type::BaseModel
      attr_accessor url: String

      attr_accessor skip_processing: bool?

      attr_accessor tags: ::Array[PostForMe::SocialPostMedia::Tag]?

      attr_accessor thumbnail_timestamp_ms: top?

      attr_accessor thumbnail_url: top?

      def initialize: (
        url: String,
        ?skip_processing: bool?,
        ?tags: ::Array[PostForMe::SocialPostMedia::Tag]?,
        ?thumbnail_timestamp_ms: top?,
        ?thumbnail_url: top?
      ) -> void

      def to_hash: -> {
        url: String,
        skip_processing: bool?,
        tags: ::Array[PostForMe::SocialPostMedia::Tag]?,
        thumbnail_timestamp_ms: top?,
        thumbnail_url: top?
      }

      type tag =
        {
          id: String,
          platform: PostForMe::Models::SocialPostMedia::Tag::platform,
          type: PostForMe::Models::SocialPostMedia::Tag::type_,
          x: Float,
          y_: Float
        }

      class Tag < PostForMe::Internal::Type::BaseModel
        attr_accessor id: String

        attr_accessor platform: PostForMe::Models::SocialPostMedia::Tag::platform

        attr_accessor type: PostForMe::Models::SocialPostMedia::Tag::type_

        attr_reader x: Float?

        def x=: (Float) -> Float

        attr_reader y_: Float?

        def y_=: (Float) -> Float

        def initialize: (
          id: String,
          platform: PostForMe::Models::SocialPostMedia::Tag::platform,
          type: PostForMe::Models::SocialPostMedia::Tag::type_,
          ?x: Float,
          ?y_: Float
        ) -> void

        def to_hash: -> {
          id: String,
          platform: PostForMe::Models::SocialPostMedia::Tag::platform,
          type: PostForMe::Models::SocialPostMedia::Tag::type_,
          x: Float,
          y_: Float
        }

        type platform = :facebook | :instagram

        module Platform
          extend PostForMe::Internal::Type::Enum

          FACEBOOK: :facebook
          INSTAGRAM: :instagram

          def self?.values: -> ::Array[PostForMe::Models::SocialPostMedia::Tag::platform]
        end

        type type_ = :user | :product

        module Type
          extend PostForMe::Internal::Type::Enum

          USER: :user
          PRODUCT: :product

          def self?.values: -> ::Array[PostForMe::Models::SocialPostMedia::Tag::type_]
        end
      end
    end
  end
end
