module PostForMe
  module Models
    type account_configuration =
      {
        configuration: PostForMe::AccountConfiguration::Configuration,
        social_account_id: String
      }

    class AccountConfiguration < PostForMe::Internal::Type::BaseModel
      attr_accessor configuration: PostForMe::AccountConfiguration::Configuration

      attr_accessor social_account_id: String

      def initialize: (
        configuration: PostForMe::AccountConfiguration::Configuration,
        social_account_id: String
      ) -> void

      def to_hash: -> {
        configuration: PostForMe::AccountConfiguration::Configuration,
        social_account_id: String
      }

      type configuration =
        {
          localizations: ::Hash[Symbol, top]?,
          allow_comment: bool?,
          allow_duet: bool?,
          allow_stitch: bool?,
          audio_name: String?,
          auto_add_music: bool?,
          board_ids: ::Array[String]?,
          caption: top?,
          category_id: String?,
          collaborators: ::Array[::Array[top]]?,
          community_id: String,
          contains_synthetic_media: bool?,
          default_language: String?,
          disclose_branded_content: bool?,
          disclose_your_brand: bool?,
          embeddable: bool?,
          is_ai_generated: bool?,
          is_draft: bool?,
          license: PostForMe::Models::AccountConfiguration::Configuration::license?,
          link: String?,
          location: String?,
          made_for_kids: bool?,
          media: ::Array[PostForMe::SocialPostMedia]?,
          placement: PostForMe::Models::AccountConfiguration::Configuration::placement?,
          poll: PostForMe::TwitterPoll,
          privacy_status: PostForMe::Models::AccountConfiguration::Configuration::privacy_status?,
          public_stats_viewable: bool?,
          publish_at: String?,
          quote_tweet_id: String,
          recording_date: String?,
          reply_settings: PostForMe::Models::AccountConfiguration::Configuration::reply_settings?,
          reshare_post_id: String?,
          set_caption_for_each_image: bool?,
          share_to_feed: bool?,
          tags: ::Array[String]?,
          title: String?,
          trial_reel_type: PostForMe::Models::AccountConfiguration::Configuration::trial_reel_type?
        }

